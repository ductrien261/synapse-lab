# ============================================================
# Chỉ cần khi chạy backend TRỰC TIẾP trên máy (không qua Docker):
#   cd be && uv run python manage.py runserver
# Chạy bằng docker compose thì dùng file .env ở thư mục gốc.
# ============================================================
DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
REDIS_URL=redis://localhost:6379/0
GEMINI_API_KEY=
