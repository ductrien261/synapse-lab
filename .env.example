# Neon Postgres — xin leader Neon branch riêng của bạn
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Gemini API key — tạo tại https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — LLM cho service AI (tạo key miễn phí tại https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Mật khẩu nội bộ giữa be và service AI (đặt chuỗi ngẫu nhiên bất kỳ)
AI_SERVICE_TOKEN=dev-ai-token

# (Tùy chọn) Langfuse — xem trace từng bước AI: https://cloud.langfuse.com -> Project -> API keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Địa chỉ web, algo-server dùng để tạo sitemap
SYNAPSE_LAB_URL=http://localhost:3100

# Neon Object Storage (Neon Console -> Object storage -> Connect)
# Để trống S3_BUCKET = lưu file local trong be/media/
# Tên bucket đã tạo trên Neon, ví dụ: uploads
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# (Tùy chọn) email tài khoản được đăng nhập bằng chữ "admin"
ADMIN_LOGIN_EMAIL=

# BigBlueButton — để false khi phát triển trên Windows (chế độ phòng mô phỏng)
BBB_ENABLED=false
BBB_URL=https://bbb.example.com/bigbluebutton/api
BBB_SECRET=
BBB_CHECKSUM_ALGORITHM=sha256
BBB_SSL_VERIFY=true
BBB_CONNECT_TIMEOUT=5
BBB_TIMEOUT=15
# URL mà chính máy chủ BBB có thể dùng để tải PDF từ backend Synapse.
# Production: https://api.synapse.example; Windows + BBB trong WSL thường dùng host.docker.internal.
BBB_ASSET_BASE_URL=http://host.docker.internal:8000
BBB_RESOURCE_URL_TTL=3600
BBB_QUIZ_TOKEN_TTL=43200
