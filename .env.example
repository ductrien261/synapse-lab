# Neon Postgres — xin leader Neon branch riêng của bạn
DATABASE_URL=
GEMINI_API_KEY=

# Groq — LLM cho service AI (tạo key miễn phí tại https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Mật khẩu nội bộ giữa be và service AI (đặt chuỗi ngẫu nhiên bất kỳ)
AI_SERVICE_TOKEN=dev-ai-token

# (Tùy chọn) Langfuse — xem trace từng bước AI: https://cloud.langfuse.com -> Project -> API keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Địa chỉ web, algo-server dùng để tạo sitemap
SYNAPSE_LAB_URL=http://localhost:3100

# Cloudflare R2 qua API tương thích S3 (dùng chung cho tài liệu và ảnh bài học)
# Để trống S3_BUCKET = lưu file local trong be/media/
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com ; region: auto
# Điền Access Key ID / Secret Access Key của R2, không phải Global API Key.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Bật sau khi upload ảnh cũ: xem be/algorithms/docs/STORAGE.md
LESSON_ASSETS_ON_S3=False

# (Tùy chọn) email tài khoản được đăng nhập bằng chữ "admin"
ADMIN_LOGIN_EMAIL=
