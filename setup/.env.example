# Merge into the project .env; do not replace the existing file.
APP_URL=

# Zoom Server-to-Server OAuth
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=

# Optional Zoom to YouTube livestream
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_AUTO_LIVESTREAM_ENABLED=false
YOUTUBE_LIVESTREAM_PRIVACY=unlisted
YOUTUBE_LIVESTREAM_PREPARE_MINUTES=120
ZOOM_YOUTUBE_QUEUE_CONNECTION=database

# Optional classroom recording storage
CLASSROOM_STORAGE=local
CLASSROOM_LOCAL_PATH=storage/app/recordings
